{
  "manifest_version": 3,
  "name": "OmniHub Chrome Companion",
  "version": "0.2.0",
  "description": "Runs the built-in linux.do search through your explicitly authorized Chrome session for OmniHub.",
  "minimum_chrome_version": "116",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://linux.do/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "OmniHub Companion",
    "default_popup": "popup.html"
  }
}
